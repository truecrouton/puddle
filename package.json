{
  "name": "puddle",
  "private": true,
  "workspaces": [
    "graphql",
    "server",
    "nextjs"
  ],
  "scripts": {
    "codegen": "npm run codegen --workspace=graphql",
    "dev": "concurrently --names \"SERVER,NEXTJS\" --prefix-colors \"cyan,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=nextjs\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:webapp": "npm run dev --workspace=nextjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}