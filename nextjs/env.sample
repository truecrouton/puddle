# Create .env.production for production build and
# create .env.local for local/dev

# API URI
NEXT_PUBLIC_GRAPHQL_URI=/api/graphql

# Base mqtt topic
NEXT_PUBLIC_BASE_TOPIC=zigbee2mqtt

# Conversion of mqtt messages with the key name 'temperature' 
# F = fahrenheit any other value = no conversion
NEXT_PUBLIC_TEMPERATURE_CONVERT_TO=F