{
  "name": "puddle",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Home automation with MQTT",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=node --target=node22 --minify --external:better-sqlite3 --outfile=dist/main.js && cp ../graphql/src/schema.graphql dist/",
    "build:all": "npm run build:server && npm run build:plugins",
    "build:plugins": "tsc --noEmit && esbuild \"src/plugin/**/*.ts\" --bundle --platform=node --target=node22 --minify --outdir=dist/plugin --outbase=src/plugin",
    "dev": "tsx watch src/main.ts",
    "migration:create": "knex migrate:make",
    "migrate:latest": "knex migrate:latest",
    "migrate:reset": "npm run migrate:rollback && npm run migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "start": "node ./dist/main.js",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "author": "Pin Tan",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/fastify": "^3.1.0",
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@types/node-schedule": "^2.1.0",
    "better-sqlite3": "^12.8.0",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "fastify": "^5.12.7",
    "graphql": "^16.14.2",
    "lru-cache": "^11.2.7",
    "mqtt": "^4.3.7",
    "node-schedule": "^2.1.1",
    "ohm-js": "^17.5.0",
    "puddle-graphql": "*",
    "suncalc": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@ngneat/falso": "^6.4.0",
    "@types/better-sqlite3": "^7.6.4",
    "@types/cookie": "^0.6.0",
    "@types/hapi__cookie": "^12.0.2",
    "@types/node": "^20.2.4",
    "@types/suncalc": "^1.9.0",
    "esbuild": "^0.28.0",
    "knex": "^2.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4",
    "vitest": "^5.0.5"
  }
}