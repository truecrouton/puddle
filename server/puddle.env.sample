# Set home location for local sun position
LOCATION_LATITUDE=0
LOCATION_LONGITUDE=0

# mqtt host ip 
# Default = 127.0.0.1
#MQTT_HOST=127.0.0.1

# Topic mqtt subscribes to
#BASE_TOPIC=zigbee2mqtt

# Server host/port
# Default = 127.0.0.1:4000
#PUDDLE_HOST=127.0.0.1
#PUDDLE_PORT=4000

# Enable TLS (Must set both)
#TLS_CERT=/etc/ssl/cert.pem
#TLS_KEY=/etc/ssl/key.pem

# Conversion of mqtt messages with the key name 'temperature' 
# F = fahrenheit
# Any other value = no conversion
TEMPERATURE_CONVERT_TO=F

# Plugins dirs to load (separate multiple dirs with commas)
#PLUGINS=wemo